PORT=5000
MONGODB_URI=mongodb://localhost:27017/portfolio
NODE_ENV=development

# CORS origins — comma-separated list of allowed frontend origins
# For local development, keep this as localhost
CLIENT_URL=http://localhost:5173

# Optional: single additional allowed origin (e.g. your Vercel domain)
# In production on Render, set this to your Vercel frontend URL:
# FRONTEND_URL=https://your-portfolio.vercel.app
FRONTEND_URL=
